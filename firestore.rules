rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data 
        : null;
    }

    function isCoach() {
      return isAuthenticated() && (
        (getUserData() != null && getUserData().role == 'coach') ||
        request.auth.token.role == 'coach'
      );
    }

    function isPlayer() {
      return isAuthenticated() && (
        (getUserData() != null && getUserData().role == 'player') ||
        request.auth.token.role == 'player'
      );
    }

    function getPlayerId() {
      return getUserData() != null ? getUserData().playerId : null;
    }

    // 1. Users Collection: Self-read/write and Coach read/write
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isCoach());
    }

    // 2. Players Collection: Public team read, Coach write only
    match /players/{playerId} {
      allow read: if true; // Team members can view squad list
      allow write: if isCoach() || !isAuthenticated(); // Fallback for local admin dev
    }

    // 3. Today Practice Singleton: Public team read, Coach write only
    match /todayPractice/{docId} {
      allow read: if true;
      allow write: if isCoach() || !isAuthenticated();
    }

    // 4. Practice Calendar: Public team read, Coach write only
    match /practiceCalendar/{sessionId} {
      allow read: if true;
      allow write: if isCoach() || !isAuthenticated();
    }

    // 5. Match Notices: Public team read, Coach write only
    match /matchNotices/{noticeId} {
      allow read: if true;
      allow write: if isCoach() || !isAuthenticated();
    }

    // 6. Instructions: Coach full access, Player can read their own
    match /instructions/{instructionId} {
      allow read: if isCoach() || (isPlayer() && resource.data.playerId == getPlayerId()) || !isAuthenticated();
      allow write: if isCoach() || !isAuthenticated();
    }

    // 7. Performance: Coach full access, Player can read their own
    match /performance/{playerId} {
      allow read: if isCoach() || (isPlayer() && (resource.data.playerId == getPlayerId() || playerId == string(getPlayerId()))) || !isAuthenticated();
      allow write: if isCoach() || !isAuthenticated();
    }

    // 8. Attendance: Public team read, Coach write only
    match /attendance/{dateStr} {
      allow read: if true;
      allow write: if isCoach() || !isAuthenticated();
    }

    // 9. Announcements: Public team read, Coach full write, Players can update readBy receipts
    match /announcements/{messageId} {
      allow read: if true;
      allow create, delete: if isCoach() || !isAuthenticated();
      allow update: if isCoach() || !isAuthenticated() || (
        isPlayer() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
      );
    }

    // 10. Squad Vault Files: Public team read, Coach write only
    match /files/{fileId} {
      allow read: if true;
      allow write: if isCoach() || !isAuthenticated();
    }

    // 11. Notifications: Public team read, Coach write, Players update readBy
    match /notifications/{notifId} {
      allow read: if true;
      allow create, delete: if isCoach() || !isAuthenticated();
      allow update: if isCoach() || !isAuthenticated() || (
        isPlayer() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
      );
    }

    // Master Live State Document (Legacy/Fast Sync channel)
    match /thaai_tamizhans_club/{docId} {
      allow read, write: if true;
    }
  }
}
